# ---------------------------------------------------------------------------
# Скопируйте этот файл в .env и заполните. .env в git не попадает.
# ---------------------------------------------------------------------------

# --- Telegram-аккаунт для парсинга (юзербот) ---
# Получить на https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# Номер телефона аккаунта в международном формате. При первом запуске
# Telegram пришлёт код подтверждения — введите его в консоли.
TG_PHONE=+77001234567
# Пароль двухфакторной аутентификации (если включён). Иначе оставьте пустым.
TG_PASSWORD=

# --- Бот, который присылает вам найденные заказы ---
# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Ваш Telegram user id (узнать у @userinfobot). Только он может управлять ботом.
OWNER_ID=123456789

# --- Gemini API (ИИ-классификатор) ---
# Ключ: https://aistudio.google.com/apikey
# Если оставить пустым — бот работает только на правилах, без ИИ.
GEMINI_API_KEY=

# --- Пути (можно не трогать) ---
CONFIG_PATH=config.yaml
DATA_DIR=data
LOG_LEVEL=INFO
